    "def compute_team_points(player_data):\n",
    "    # Initialize the result dictionary\n",
    "    team_points = {}\n",
    "\n",
    "    for player_id, player_info in player_data.items():\n",
    "        team = player_info['team']\n",
    "        position = player_info['position']\n",
    "        total_points = player_info['total_points']\n",
    "\n",
    "        # Determine if the player contributes to Attack or Defence\n",
    "        if position in ['Forward', 'Midfielder']:\n",
    "            category = 'Attack'\n",
    "        elif position in ['Defender', 'Goalkeeper']:\n",
    "            category = 'Defence'\n",
    "        else:\n",
    "            continue  # Skip unknown positions\n",
    "\n",
    "        # Initialize the team in the dictionary if not already present\n",
    "        if team not in team_points:\n",
    "            team_points[team] = {'Attack': 0, 'Defence': 0}\n",
    "\n",
    "        # Add the player's points to the appropriate category\n",
    "        team_points[team][category] += total_points\n",
    "\n",
    "    return team_points"
   ]
  },
