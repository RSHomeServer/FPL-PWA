    "#Name mapping helper functions\n",
    "\n",
    "#Returns all names and ids that match partial input\n",
    "#Useful esp when names contain accents or game uses variation\n",
    "def search_by_partial_name(partial_name):\n",
    "    partial_name = partial_name.lower()\n",
    "    matching_players = []\n",
    "\n",
    "    # Search through full names\n",
    "    for player_id, full_name in id_to_name_mapping.items():\n",
    "        if partial_name in full_name.lower():  # Check if the partial name matches the full name\n",
    "            matching_players.append((player_id, full_name))\n",
    "\n",
    "    if matching_players:\n",
    "        print(f\"Players matching '{partial_name}':\")\n",
    "        for player in matching_players:\n",
    "            print(f\"ID: {player[0]}, Name: {player[1]}\")\n",
    "            return(player[0])\n",
    "    else:\n",
    "        print(f\"No players found matching '{partial_name}'.\")\n",
    "\n",
    "#Outputs name from id input\n",
    "def get_name_by_id(player_id):\n",
    "    return id_to_name_mapping.get(player_id, \"No player found with that ID.\")\n"
