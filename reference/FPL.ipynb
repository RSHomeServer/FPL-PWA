    "def calculate_goalkeeper_points_for_game(expected_goals, save_probability):\n",
    "    # Expected goals is the number of goals expected to be scored against the goalkeeper\n",
    "    goals_conceded = expected_goals\n",
    "\n",
    "    # Estimate clean sheet probability based on defensive rating\n",
    "    clean_sheet_probability = 1 - (goals_conceded * 0.5)  # Adjust the multiplier as needed\n",
    "\n",
    "    # Calculate points from clean sheets\n",
    "    clean_sheet_points = 4 * clean_sheet_probability\n",
    "\n",
    "    # Calculate expected number of saves (1 point for every 3 saves)\n",
    "    expected_saves = save_probability * (goals_conceded * 3)  # Assuming the expected shots are proportional to goals conceded\n",
    "\n",
    "    # Calculate points from saves (1 point for every 3 saves)\n",
    "    save_points = expected_saves // 3\n",
    "\n",
    "    # Calculate points lost from goals conceded (-1 point for every 2 goals conceded)\n",
    "    goals_lost_points = - (goals_conceded // 2)\n",
    "\n",
    "    # Total points for the goalkeeper, ensuring we don't go below zero\n",
    "    total_points = clean_sheet_points + save_points + goals_lost_points\n",
    "    return max(total_points, 0)  # Return 0 if total points is negative\n",
    "\n",
    "# Example of usage within your loop\n",
    "expected_points = defaultdict(float)\n",
    "\n",
    "# Process each fixture for the next `num_weeks` starting from the current gameweek\n",
    "for gw in range(current_gameweek, current_gameweek + 3):  # Assuming you want the next 3 gameweeks\n",
    "    if gw not in cold_fixtures:\n",
    "        continue  # Skip if no fixtures are available for this gameweek\n",
    "\n",
    "    for home_team, away_team in cold_fixtures[gw]:\n",
    "        # Calculate expected goals for each team using attack and defense ratings\n",
    "        home_expected_goals = attack_ratings[home_team] * defense_ratings[away_team]\n",
    "        away_expected_goals = attack_ratings[away_team] * defense_ratings[home_team]\n",
    "\n",
    "        # Calculate expected points for the home team's goalkeeper\n",
    "        home_points = calculate_goalkeeper_points_for_game(home_expected_goals, save_probabilities[home_team])\n",
    "        expected_points[home_team] += home_points\n",
    "\n",
    "        # Calculate expected points for the away team's goalkeeper\n",
    "        away_points = calculate_goalkeeper_points_for_game(away_expected_goals, save_probabilities[away_team])\n",
    "        expected_points[away_team] += away_points\n",
    "\n",
    "# Print the expected points for each goalkeeper\n",
    "pprint(expected_points)"
   ]
  },
