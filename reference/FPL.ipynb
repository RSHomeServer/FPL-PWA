    "#Grab all fixtures, past and upcoming\n",
    "#Format: {week_no: [(home_1, away_1), (home_2, away_2)..], }\n",
    "def get_fpl_fixtures():\n",
    "    # Make sure to fetch the fixtures from the correct endpoint\n",
    "    response = requests.get(\"https://fantasy.premierleague.com/api/fixtures/\")\n",
    "    fixtures_data = response.json()\n",
    "\n",
    "    # Extract fixtures for each gameweek\n",
    "    fixtures_by_gameweek = {}\n",
    "    for fixture in fixtures_data:\n",
    "        gameweek = fixture['event']  # Gameweek number\n",
    "        home_team = fixture['team_h']  # Home team ID\n",
    "        away_team = fixture['team_a']   # Away team ID\n",
    "\n",
    "        if gameweek not in fixtures_by_gameweek:\n",
    "            fixtures_by_gameweek[gameweek] = []\n",
    "        \n",
    "        # Append tuple of (home team ID, away team ID)\n",
    "        fixtures_by_gameweek[gameweek].append((home_team, away_team))\n",
    "\n",
    "    return fixtures_by_gameweek\n",
    "\n",
    "def convert_fixtures_to_names(fixtures, team_mapping):\n",
    "    # Initialize an empty dictionary for the converted fixtures\n",
    "    converted_fixtures = {}\n",
    "    \n",
    "    for game_week, matches in fixtures.items():\n",
    "        # Convert each match tuple (team_1, team_2) to their respective names\n",
    "        converted_matches = [(team_mapping[team_1], team_mapping[team_2]) for team_1, team_2 in matches]\n",
    "        # Store the converted matches in the new dictionary\n",
    "        converted_fixtures[game_week] = converted_matches\n",
    "    \n",
    "    return converted_fixtures\n",
    "    \n",
    "cold_fixtures = get_fpl_fixtures()\n",
    "string_fixtures = convert_fixtures_to_names(cold_fixtures, team_mapping)\n",
    "cs_fixtures = {key: value for key, value in string_fixtures.items() if key > current_gameweek}\n",
    "clipped_fixtures = {key: value for key, value in string_fixtures.items() if key > current_gameweek and key < current_gameweek + 4}"
   ]
