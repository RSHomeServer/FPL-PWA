    "def compute_point_differences(fixtures, total_points):\n",
    "    attack_result = {}\n",
    "    defense_result = {}\n",
    "    \n",
    "    for gw, matches in fixtures.items():\n",
    "        attack_differences = []\n",
    "        defense_differences = []\n",
    "        \n",
    "        \n",
    "        for home_team, away_team in matches:\n",
    "            # Get attack and defense points for both teams\n",
    "            home_attack = total_points[home_team][\"Attack\"]\n",
    "            home_defense = total_points[home_team][\"Defence\"]\n",
    "            away_attack = total_points[away_team][\"Attack\"]\n",
    "            away_defense = total_points[away_team][\"Defence\"]\n",
    "            \n",
    "            # Calculate differences\n",
    "            home_attack_split = home_attack - away_defense\n",
    "            away_attack_split = away_attack - home_defense\n",
    "\n",
    "            home_defense_split = -away_attack_split\n",
    "            away_defense_split = -home_attack_split\n",
    "            \n",
    "            # Append both splits to the array\n",
    "            attack_differences.append((home_team, home_attack_split))\n",
    "            attack_differences.append((away_team, away_attack_split))\n",
    "\n",
    "            defense_differences.append((home_team, home_defense_split))\n",
    "            defense_differences.append((away_team, away_defense_split))\n",
    "        \n",
    "        # Sort by attack differences (home_split and away_split combined)\n",
    "        attack_sorted = sorted(attack_differences, key=lambda x: x[1], reverse=True)\n",
    "        \n",
    "        # Sort by defense differences (opposite of attack differences)\n",
    "        defense_sorted = sorted(defense_differences, key=lambda x: x[1], reverse=True)\n",
    "        \n",
    "        # Extract ordered lists of teams\n",
    "        #ordered_attack = [(home, away, split) for home, away, split, _ in attack_sorted]\n",
    "        #ordered_defense = [(home, away, split) for home, away, split, _ in defense_sorted]\n",
    "        attack_result[gw] = [attack_sorted] #, defense_sorted]\n",
    "        defense_result[gw] = [defense_sorted]\n",
    "\n",
    "\n",
    "    total_attack = {}\n",
    "    total_defense = {}\n",
    "    \n",
    "    for gw, gameweek_data in attack_result.items():\n",
    "        attack_list = gameweek_data[0]  # Extract the attack list\n",
    "        \n",
    "        for team, attack_value in attack_list:\n",
    "            if team in total_attack:\n",
    "                total_attack[team] += attack_value\n",
    "            else:\n",
    "                total_attack[team] = attack_value\n",
    "\n",
    "    for gw, gameweek_data in defense_result.items():\n",
    "        attack_list = gameweek_data[0]  # Extract the attack list\n",
    "        \n",
    "        for team, attack_value in attack_list:\n",
    "            if team in total_defense:\n",
    "                total_defense[team] += attack_value\n",
    "            else:\n",
    "                total_defense[team] = attack_value\n",
    "    \n",
    "    # Sort teams by total attack potential in descending order\n",
    "    sorted_attack = sorted(total_attack.items(), key=lambda x: x[1], reverse=True)\n",
    "    sorted_defense = sorted(total_defense.items(), key=lambda x: x[1], reverse=True)\n",
    "            \n",
    "    return(attack_result, defense_result, sorted_attack, sorted_defense)"
   ]
