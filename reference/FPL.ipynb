    "\n",
    "#Constructs player name and ID mapping\n",
    "#Uses FPL ID's and just ties it to names so we can quickly find IDs of players\n",
    "def build_player_name_to_id_mapping():\n",
    "    # Fetch general data from FPL API\n",
    "    response = requests.get(\"https://fantasy.premierleague.com/api/bootstrap-static/\")\n",
    "    data = response.json()\n",
    "\n",
    "    id_to_name = {}\n",
    "\n",
    "    for player in data['elements']:\n",
    "        full_name = f\"{player['first_name']} {player['second_name']}\"\n",
    "        player_id = player['id']\n",
    "\n",
    "        id_to_name[player_id] = full_name\n",
    "\n",
    "    return id_to_name\n",
    "\n",
    "id_to_name_mapping = build_player_name_to_id_mapping()\n"
