    "\n",
    "def expanded_fixtures():\n",
    "    # Fetch the fixtures from the correct endpoint\n",
    "    response = requests.get(\"https://fantasy.premierleague.com/api/fixtures/\")\n",
    "    fixtures_data = response.json()\n",
    "\n",
    "    # Extract fixtures with goals and saves for each gameweek\n",
    "    fixtures_by_gameweek = {}\n",
    "    for fixture in fixtures_data:\n",
    "        gameweek = fixture['event']  # Gameweek number\n",
    "        home_team = fixture['team_h']  # Home team ID\n",
    "        away_team = fixture['team_a']  # Away team ID\n",
    "        home_goals = fixture.get('team_h_score', 0)  # Goals scored by home team\n",
    "        away_goals = fixture.get('team_a_score', 0)  # Goals scored by away team\n",
    "\n",
    "        # Initialize saves for each team\n",
    "        home_saves = 0\n",
    "        away_saves = 0\n",
    "\n",
    "        # Search for saves within the 'stats' field\n",
    "        for stat in fixture['stats']:\n",
    "            if stat['identifier'] == 'saves':\n",
    "                # Sum up saves for the home team and the away team\n",
    "                home_saves = sum(item['value'] for item in stat['h'])\n",
    "                away_saves = sum(item['value'] for item in stat['a'])\n",
    "\n",
    "        # Add fixture data to the gameweek dictionary\n",
    "        if gameweek not in fixtures_by_gameweek:\n",
    "            fixtures_by_gameweek[gameweek] = []\n",
    "\n",
    "        # Append a dictionary with fixture details\n",
    "        fixtures_by_gameweek[gameweek].append({\n",
    "            'home_team': home_team,\n",
    "            'away_team': away_team,\n",
    "            'home_goals': home_goals,\n",
    "            'away_goals': away_goals,\n",
    "            'home_saves': home_saves,\n",
    "            'away_saves': away_saves\n",
    "        })\n",
    "\n",
    "    return fixtures_by_gameweek\n",
    "\n",
    "# Call the function to see the results\n",
    "expanded_f = expanded_fixtures()\n"
   ]
