    "def calculate_team_ratings(fixtures_by_gameweek):\n",
    "    # Initialize stats for goals and saves\n",
    "    goals_scored = defaultdict(int)\n",
    "    goals_conceded = defaultdict(int)\n",
    "    saves = defaultdict(int)\n",
    "    shots_on_target = defaultdict(int)\n",
    "    games_played = defaultdict(int)\n",
    "\n",
    "    # Loop through each gameweek and fixture to accumulate team stats\n",
    "    for gameweek, fixtures in fixtures_by_gameweek.items():\n",
    "        for fixture in fixtures:\n",
    "            home_team = fixture['home_team']\n",
    "            away_team = fixture['away_team']\n",
    "            home_goals = fixture['home_goals']\n",
    "            away_goals = fixture['away_goals']\n",
    "            home_saves = fixture['home_saves']\n",
    "            away_saves = fixture['away_saves']\n",
    "\n",
    "            # Handle None values\n",
    "            home_goals = 0 if home_goals is None else home_goals\n",
    "            away_goals = 0 if away_goals is None else away_goals\n",
    "            home_saves = 0 if home_saves is None else home_saves\n",
    "            away_saves = 0 if away_saves is None else away_saves\n",
    "            \n",
    "            # Update stats for goals scored, conceded, saves, and games played\n",
    "            goals_scored[home_team] += home_goals \n",
    "            goals_scored[away_team] += away_goals\n",
    "            goals_conceded[home_team] += away_goals\n",
    "            goals_conceded[away_team] += home_goals\n",
    "\n",
    "            saves[home_team] += home_saves\n",
    "            saves[away_team] += away_saves\n",
    "            shots_on_target[home_team] += away_goals + home_saves\n",
    "            shots_on_target[away_team] += home_goals + away_saves\n",
    "\n",
    "            # Track games played for each team\n",
    "            games_played[home_team] += 1\n",
    "            games_played[away_team] += 1\n",
    "\n",
    "    # Calculate league averages\n",
    "    total_goals = sum(goals_scored.values())\n",
    "    total_games = sum(games_played.values()) // 2  # Divided by 2 since each match has two teams\n",
    "    league_avg_goals = total_goals / total_games\n",
    "\n",
    "    # Calculate attack, defense ratings, and save probability\n",
    "    attack_ratings = {}\n",
    "    defense_ratings = {}\n",
    "    save_probabilities = {}\n",
    "\n",
    "    for team in goals_scored.keys():\n",
    "        # Calculate per-game scoring/conceding relative to league average\n",
    "        attack_ratings[team] = (goals_scored[team] / games_played[team]) / league_avg_goals\n",
    "        defense_ratings[team] = (goals_conceded[team] / games_played[team]) / league_avg_goals\n",
    "        save_probabilities[team] = saves[team] / shots_on_target[team] if shots_on_target[team] > 0 else 0\n",
    "\n",
    "    return attack_ratings, defense_ratings, save_probabilities"
   ]
  },
