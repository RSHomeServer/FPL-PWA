    "\n",
    "#Function to get player data from FPL API\n",
    "#This is general data (Name, Cost, Total points, Team, Position, Minutes played, % selected)\n",
    "def get_fpl_data():\n",
    "    general_response = requests.get(\"https://fantasy.premierleague.com/api/bootstrap-static/\")\n",
    "    general_data = general_response.json()\n",
    "    \n",
    "    players = general_data['elements']\n",
    "    teams = {team['id']: team['name'] for team in general_data['teams']}\n",
    "    positions = {position['id']: position['singular_name'] for position in general_data['element_types']}\n",
    "    \n",
    "    player_profiles = [{}, {}]\n",
    "\n",
    "    for player in players:\n",
    "        player_id = player['id']\n",
    "        full_name = f\"{player['first_name']} {player['second_name']}\"\n",
    "        total_points = player['total_points']\n",
    "        cost = player['now_cost'] / 10  # cost is in tenths of million\n",
    "        team = teams[player['team']]\n",
    "        position = positions[player['element_type']]\n",
    "        minutes_played = player['minutes']\n",
    "        selected_by_percent = player['selected_by_percent']\n",
    "        \n",
    "        player_profiles[0][player_id] = {\n",
    "            'full_name': full_name,\n",
    "            'id': player_id,\n",
    "            'total_points': total_points,\n",
    "            'cost': cost,\n",
    "            'team': team,\n",
    "            'position': position,\n",
    "            'total_minutes': minutes_played,\n",
    "            'selected_by_percent': selected_by_percent,\n",
    "        }\n",
    "\n",
    "        player_profiles[1][player_id] = {y: {} for y in range(1, current_gameweek + 1)}\n",
    "    \n",
    "    return player_profiles\n",
    "\n",
    "\n",
    "#Function to get player data from FPL API\n",
    "#This is gameweek data (Per week: points, minutes, goals scored, etc etc)\n",
    "def add_gameweek_data(player_profiles, gameweek, fixtures):\n",
    "    gw_response = requests.get(f\"https://fantasy.premierleague.com/api/event/{gameweek}/live/\")\n",
    "    gw_data = gw_response.json()\n",
    "\n",
    "    # Iterate through the list of player data\n",
    "    for player_data in gw_data['elements']:\n",
    "        player_id = player_data['id']  # Access player ID directly from the list\n",
    "        \n",
    "        if player_id in player_profiles[0].keys():\n",
    "            gw_stats = player_data['stats']\n",
    "            team_id = player_profiles[0][player_id]['team']  # Get the player's team\n",
    "            \n",
    "            team_num = idByTeam(team_id)\n",
    "            \n",
    "            # Find the opposing team from the fixtures structure\n",
    "            opposing_team_id = None\n",
    "            home_or_away = None\n",
    "            \n",
    "            fix, opposing_team_id, home_or_away = fixtureFinder(team_num, gameweek)\n",
    "            \n",
    "            # Add gameweek data for the player\n",
    "            player_profiles[1][player_id][gameweek] = {\n",
    "                'points': gw_stats['total_points'],\n",
    "                'minutes': gw_stats['minutes'],\n",
    "                'goals_scored': gw_stats['goals_scored'],\n",
    "                'assists': gw_stats['assists'],\n",
    "                'xG': gw_stats['expected_goals'],\n",
    "                'xA': gw_stats['expected_assists'],\n",
    "                'goals_conceded': gw_stats['goals_conceded'],\n",
    "                'clean_sheets': gw_stats['clean_sheets'],\n",
    "                'penalties_saved': gw_stats['penalties_saved'],\n",
    "                'penalties_missed': gw_stats['penalties_missed'],\n",
    "                'saves': gw_stats['saves'],\n",
    "                'bonus': gw_stats['bonus'],\n",
    "                'yellow_cards': gw_stats['yellow_cards'],\n",
    "                'red_cards': gw_stats['red_cards'],\n",
    "                'opposing_team_id': opposing_team_id,  # Store the opposing team\n",
    "                'opposing_team': teamById(opposing_team_id),\n",
    "                'home_or_away': home_or_away  # Store if the match was home or away\n",
    "            }\n",
    "\n",
    "def compile_player_profiles(max_gameweek):\n",
    "    player_profiles = get_fpl_data()\n",
    "    fixtures = get_fpl_fixtures()  # Get the fixtures data\n",
    "\n",
    "    # Add gameweek data for each player (for all gameweeks up to max_gameweek)\n",
    "    for gw in range(1, max_gameweek + 1):\n",
    "        add_gameweek_data(player_profiles, gw, fixtures)\n",
    "\n",
    "    return player_profiles"
   ]
