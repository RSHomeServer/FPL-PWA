    "#Fixture helper functions\n",
    "\n",
    "#Maps team_id to name\n",
    "def teamById(my_id):\n",
    "    return(team_mapping[my_id])\n",
    "\n",
    "#Maps name to team_id\n",
    "def idByTeam(team):\n",
    "    return(get_key(team_mapping, team))\n",
    "\n",
    "#Finds fixtures involving team in a particular game week\n",
    "#Input: team_id, game_week_no\n",
    "#Output: (fixture, opposition, home/away flag)  (Note: This will need to be refactored when more than 1 game per week) \n",
    "def fixtureFinder(my_id, gw):\n",
    "    fW = cold_fixtures[gw]\n",
    "    \n",
    "    fix = [tup for tup in fW if my_id in tup]\n",
    "    \n",
    "    if len(fix) == 1:\n",
    "        tup = fix[0]\n",
    "        index = tup.index(my_id)  # Get the index of the number in the tuple\n",
    "        opposition = tup[1 - index]\n",
    "        side = \"H\" if index == 0 else \"A\"\n",
    "        \n",
    "        return(tup, opposition, side)\n",
    "        \n",
    "    return(fix)\n",
    "\n",
    "#Finds fixtures using team name instead of team_id (defunct, should avoid handling strings, use for debug only)\n",
    "def fixtureFinderByTeam(team, gw):\n",
    "    my_id = idByTeam(team)\n",
    "    return(fixtureFinder(my_id, gw))"
   ]
